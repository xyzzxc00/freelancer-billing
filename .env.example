# 可公開的設定範本，真實值只放在被 Git 忽略的 .env。
# 換電腦／備份與各變數取得方式：docs/recovery.md
# Supabase 專案設定（Project Settings → API / Connect）
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxx"

# 從 Supabase Connect 複製完整連線字串（含正確使用者／主機），密碼需 URL 編碼。
# DATABASE_URL 使用 transaction pooler；下面只是範例，不是可用的連線。
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true"
# Prisma CLI 使用 direct 或 session pooler（5432），不可使用 transaction pooler。
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Resend（Email 通知）— 前往 resend.com 取得 API key
# 本機預設停用寄信；需要測試時再填入有效 key。
RESEND_API_KEY=""
# 寄件人 email，需先在 Resend 驗證 domain（例如 noreply@jieanbook.com）
RESEND_FROM_EMAIL="接案帳本 <noreply@jieanbook.com>"
# 每日寄信上限（選填，預設 90），用來在達到 Resend 方案限制前主動停止寄送
RESEND_DAILY_LIMIT="90"

# 意見回饋收件信箱（feedback 表單寄送目的地）
ADMIN_EMAIL="your@email.com"

# Cron 驗證 token。留空時拒絕 cron 請求；正式環境使用獨立的隨機密鑰。
# 換電腦不需要重新產生或更換正式 CRON_SECRET。
CRON_SECRET=""

# 網站對外網址（選填）。不設時會自動 fallback 到 Vercel 提供的 VERCEL_URL，
# 正式環境改用自訂網域時建議明確設定，避免 email 內連結指向預覽網址。
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# VERCEL_API_TOKEN、VERCEL_OIDC_TOKEN 屬於管理工具憑證，網站執行不需要。
# 不要將管理 token 填進這份範本或任何 NEXT_PUBLIC_* 變數。
