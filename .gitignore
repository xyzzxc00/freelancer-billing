# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase
supabase/.temp

# claude code local settings
.claude/settings.local.json

# 工具端自動產生的 .claude/skills 鏡像副本，真正版本控管的是 .claude/ 底下那份
.agents/

# typescript
*.tsbuildinfo
next-env.d.ts

